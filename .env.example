# VPS 公网 IP 或域名
PUBLIC_HOST=YOUR_SERVER_PUBLIC_IP_OR_DOMAIN
# SRT 流路径名称
STREAM_PATH=phone
# SRT 监听端口 (UDP)
SRT_PORT=8890
# 手机端推流延迟 (微秒, 建议 500-2000)
SRT_PUBLISH_LATENCY=500
# OBS 拉流延迟 (微秒, 建议 500000-2000000)
SRT_READ_LATENCY=500000
# 推流密码 (手机端使用)
SRT_PUBLISH_PASSPHRASE=CHANGE_ME_PUBLISH_123456
# 拉流密码 (OBS 端使用)
SRT_READ_PASSPHRASE=CHANGE_ME_READ_123456
