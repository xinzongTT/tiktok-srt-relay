# VPS 公网 IP 或域名
PUBLIC_HOST=YOUR_SERVER_PUBLIC_IP_OR_DOMAIN
# SRT 流路径名称 (手机视频通道)
STREAM_PATH=phone
# SRT 监听端口 (UDP)
SRT_PORT=8890
# 手机端推流延迟 (毫秒, 建议 300-1000, 至少2倍RTT)
# RTT=155ms → 建议 >= 400ms
SRT_PUBLISH_LATENCY=400
# OBS 拉流延迟 (微秒, FFmpeg 使用微秒)
# 500000 us = 500ms, 跨太平洋建议 >= 500ms
SRT_READ_LATENCY=500000
# 推流密码 (手机端使用)
SRT_PUBLISH_PASSPHRASE=CHANGE_ME_PUBLISH_123456
# 拉流密码 (OBS 端使用)
SRT_READ_PASSPHRASE=CHANGE_ME_READ_123456

# 音乐同步通道路径 (美国推送桌面音频 -> 中国播放)
MUSIC_PATH=music
# 音乐通道推流密码 (美国端使用)
MUSIC_PUBLISH_PASSPHRASE=CHANGE_ME_MUSIC_PUB_123456
# 音乐通道拉流密码 (中国端使用)
MUSIC_READ_PASSPHRASE=CHANGE_ME_MUSIC_READ_123456
# 音乐 SRT 延迟 (微秒, 建议 500000-2000000)
MUSIC_LATENCY=500000

# Central monitor reporter
# HUB=http://23.238.118.221:9988/api/report
# REPORTER_NAME=relay-1
